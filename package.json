{
  "name": "tileforge-actor-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test:mcp": "tsx mcp/test/smoke.ts && tsx mcp/test/session-compatibility.ts && tsx mcp/test/candidate-compatibility.ts",
    "test:mcp:http": "tsx mcp/test/http-smoke.ts",
    "test:mcp:stdio": "tsx mcp/test/stdio-smoke.ts",
    "tauri": "tauri",
    "mcp": "tsx mcp/src/index.ts",
    "mcp:stdio": "tsx mcp/src/index.ts --transport stdio",
    "mcp:http": "tsx mcp/src/index.ts --transport http"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@tauri-apps/api": "^2.0.0",
    "pngjs": "7.0.0",
    "svelte": "^5.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pngjs": "6.0.5",
    "svelte-check": "^4.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "overrides": {
    "@hono/node-server": "2.0.12"
  }
}
