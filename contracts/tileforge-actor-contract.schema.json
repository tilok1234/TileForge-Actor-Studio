{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tileforge.local/contracts/tileforge-actor-contract.schema.json",
  "title": "TileForge Actor Studio contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "title",
    "sourceBoundary",
    "frame",
    "art",
    "animation",
    "approval"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 1 },
    "sourceBoundary": { "type": "string", "minLength": 1 },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "actorHeightMin",
        "actorHeightMax",
        "footAnchor",
        "hardAlpha"
      ],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "actorHeightMin": { "type": "integer", "minimum": 1 },
        "actorHeightMax": { "type": "integer", "minimum": 1 },
        "footAnchor": {
          "type": "array",
          "prefixItems": [{ "type": "integer" }, { "type": "integer" }],
          "items": false
        },
        "hardAlpha": { "type": "boolean" }
      }
    },
    "art": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lightDirection",
        "outline",
        "paletteMaxColors",
        "minimumGroundLumaDistance"
      ],
      "properties": {
        "lightDirection": { "type": "string" },
        "outline": { "type": "string" },
        "paletteMaxColors": { "type": "integer", "minimum": 1 },
        "minimumGroundLumaDistance": { "type": "number", "minimum": 0 }
      }
    },
    "animation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "directions",
        "initialClip",
        "framesPerDirection",
        "frameDurationMs",
        "groundContact"
      ],
      "properties": {
        "directions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "initialClip": { "type": "string" },
        "framesPerDirection": { "type": "integer", "minimum": 1 },
        "frameDurationMs": { "type": "integer", "minimum": 1 },
        "groundContact": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "row"],
          "properties": {
            "mode": { "const": "foot-anchor-row" },
            "row": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agentsMayApprove", "immutableGenerations"],
      "properties": {
        "agentsMayApprove": { "const": false },
        "immutableGenerations": { "const": true }
      }
    }
  }
}
